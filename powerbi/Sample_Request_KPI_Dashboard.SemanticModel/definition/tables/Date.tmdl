		lineageTag: 6e488a25-0c77-45c5-a79e-c04d9edaf225
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 835c662a-1964-441e-80e3-91f115d1b175
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month No'
		formatString: 0
		lineageTag: f15fcf1e-3a05-472b-8445-e6f9bc91680f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

