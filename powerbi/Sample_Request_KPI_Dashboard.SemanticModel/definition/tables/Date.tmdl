	column 'Year Week'
		formatString: 0
		lineageTag: 1107f4c8-4847-4324-9376-3b35bff48f78
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Week]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2024,10,1), DATE(2026,12,31)),
				    "Year", YEAR([Date]),
				    "Month No", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Week No", WEEKNUM([Date], 2),
				    "Year Week", YEAR([Date]) * 100 + WEEKNUM([Date], 2)
				)

	annotation PBI_Id = 78120c53f4674775a92379fa8f36dd5d

